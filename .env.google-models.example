# ===== Required Configuration =====
NUM_WORKERS_PER_QUEUE=8
PORT=3002
HOST=0.0.0.0
USE_DB_AUTHENTICATION=false

# Redis configuration
REDIS_URL=redis://redis:6379
REDIS_RATE_LIMIT_URL=redis://redis:6379
PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape

# Supabase Configuration
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_SERVICE_TOKEN=your-supabase-service-token
SUPABASE_ANON_TOKEN=your-supabase-anon-token

# ===== Multi-LLM Provider Configuration =====
# Primary LLM provider (Google Gemini)
LLM_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key-here

# Google Gemini Model Selection Guide:
# 
# LATEST STABLE MODELS (Recommended for production):
# - gemini-2.5-flash: Best price-performance, adaptive thinking, multimodal (最新・コスパ最高)
# - gemini-2.5-pro: Most powerful, enhanced reasoning, complex tasks (最強モデル)
# - gemini-2.0-flash: Fast, next-gen features, 1M context (高速・次世代機能)
# - gemini-2.0-flash-lite: Most cost-efficient, low latency (最安・低遅延)
# - gemini-1.5-flash: Stable, versatile, proven performance (安定版)
# - gemini-1.5-pro: Complex reasoning, 2M context window (複雑な推論用)
#
# PREVIEW/EXPERIMENTAL MODELS (Use with caution):
# - gemini-2.5-flash-lite-preview-06-17: Preview of lite version
# - gemini-2.0-flash-exp: Experimental with thinking support
#
# EMBEDDING MODELS:
# - text-embedding-004: High quality embeddings (768 dims)
# - embedding-001: Basic embeddings (768 dims)

# Recommended configuration for best performance:
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# Feature-specific configurations using Google Gemini
# Extract: Use Flash for cost efficiency
EXTRACT_MODEL_PROVIDER=google
EXTRACT_MODEL_NAME=gemini-2.5-flash

# Embeddings: Use text-embedding-004 for better quality
EMBEDDING_MODEL_PROVIDER=google
EMBEDDING_MODEL_NAME=text-embedding-004

# Research: Use Pro for complex analysis or Flash for efficiency
RESEARCH_MODEL_PROVIDER=google
RESEARCH_MODEL_NAME=gemini-2.5-flash  # Or gemini-2.5-pro for complex research

# LLMs.txt generation: Use Flash for efficiency
LLMSTXT_MODEL_PROVIDER=google
LLMSTXT_MODEL_NAME=gemini-2.5-flash

# Legacy support (kept for backward compatibility)
MODEL_NAME=gemini-2.5-flash

# ===== Alternative Model Configurations =====
# 
# For maximum performance (higher cost):
# GOOGLE_GEMINI_MODEL=gemini-2.5-pro
# EXTRACT_MODEL_NAME=gemini-2.5-pro
# RESEARCH_MODEL_NAME=gemini-2.5-pro
#
# For minimum cost (lower performance):
# GOOGLE_GEMINI_MODEL=gemini-2.0-flash-lite
# EXTRACT_MODEL_NAME=gemini-2.0-flash-lite
# RESEARCH_MODEL_NAME=gemini-2.0-flash-lite
#
# For stable production (if 2.5 models have issues):
# GOOGLE_GEMINI_MODEL=gemini-1.5-flash
# EXTRACT_MODEL_NAME=gemini-1.5-flash
# RESEARCH_MODEL_NAME=gemini-1.5-flash

# Bull queue authentication
BULL_AUTH_KEY=CHANGEME

# Logging level
LOGGING_LEVEL=info

# ===== Optional: Price Override Configuration =====
# If models are not in the pricing database, you can override prices
# Prices are in USD per million tokens
# 
# Example for gemini-2.5-flash (if not in database):
# PRICE_OVERRIDE_INPUT_gemini-2.5-flash=0.075
# PRICE_OVERRIDE_OUTPUT_gemini-2.5-flash=0.30
#
# Example for gemini-2.5-pro (if not in database):
# PRICE_OVERRIDE_INPUT_gemini-2.5-pro=1.25
# PRICE_OVERRIDE_OUTPUT_gemini-2.5-pro=5.00
#
# Example for gemini-2.0-flash-lite (if not in database):
# PRICE_OVERRIDE_INPUT_gemini-2.0-flash-lite=0.01
# PRICE_OVERRIDE_OUTPUT_gemini-2.0-flash-lite=0.04